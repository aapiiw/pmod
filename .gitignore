# MyBot.run AUTOIT .gitignore file

# Global Files
/.project
*.ini
*.log
*.orig
*.png
*.jpg
*.bmp
*.zip
*.bat
build.bat
BuildMBR.exe

# don't exclude exe in lib folder
!lib/*.exe
!lib/*/*.exe
!lib/*.dll
!lib/*/*.dll

# image templates in imgxml are needed by the bot (some are .bmp)
!imgxml/**/*.bmp

# GUI / Telegram texts of the bot language (*.ini is ignored above): without it the 219 reused texts show "-3"
# and the bot cannot write it back (no Languages folder in a fresh clone). Other languages are not used
![Ll]anguages/English.ini

# Exclude Global Folders (Profiles: account settings, Telegram tokens, logs - copy config.ini / building.ini by hand)
[Pp]rofiles/
[Tt]emplates/
[Tt]emp/
[Bb]ackup/

# Mod TestFiles
COCBot/Test420/*

# Obsolete Files and Folders
[Ll]oots/
[Aa]llTowns/

# Exclusion Curl (used for PushBullet)
![Cc]url.exe

# Exclusion build
![Bb]uild/**
build/**
build/MBR_Compiler/MBR_Compiler/bin/*
build/MBR_Compiler/MBR_Compiler/obj/*
build/MBR_Compiler/.vs/*

